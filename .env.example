# wowlidator — LLM routing and runtime configuration.
# Copy to .env and fill in whichever providers you actually use.
# Verify everything resolves with:  wowlidator doctor

# ---------------------------------------------------------------------------
# Provider keys. You only need a key for the providers your roles point at.
# A run with --no-heal, --no-agent and no `generate` needs no keys at all.
# ---------------------------------------------------------------------------

# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# EmmieDev — https://chat.emmiedev.com (OpenAI-compatible, keys start `ek-`;
# the server ignores the model field, so no WOWLIDATOR_<ROLE>_MODEL is needed)
EMMIEDEV_API_KEY=

# Z.AI (Zhipu GLM) — https://z.ai/manage-apikey/apikey-list
# OpenAI-compatible; model ids like `glm-4.6`, `glm-4.5-air`
ZAI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
# OpenAI-compatible; model ids `deepseek-chat` (V3) and `deepseek-reasoner` (R1)
DEEPSEEK_API_KEY=

# Local model — an OpenAI-compatible server on this machine (mlx_lm.server,
# llama.cpp, vLLM, LM Studio). No key needed; set one only if your server
# demands it. Point any role at it: WOWLIDATOR_HEALER_PROVIDER=local
# The server answers with the model it loaded, so there is no model to name:
# WOWLIDATOR_<ROLE>_MODEL is ignored for this provider (same as emmiedev).
# Catalog rows are authored one at a time on it (it answers one call at a time);
# --author-concurrency overrides.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_API_KEY=
# One role can use a different local server (a second rerise on another port):
# WOWLIDATOR_<ROLE>_BASE_URL overrides LOCAL_LLM_BASE_URL for that role only.
# The panel's port field next to a role set to "local" writes this line.
# WOWLIDATOR_GENERATOR_BASE_URL=http://localhost:8081/v1
# How long one local call may take before the client gives up (ms). A 20k-token
# authoring prompt takes 1–5 minutes on a laptop; Node's default is 300 s.
# LOCAL_LLM_TIMEOUT_MS=900000

# Google AI Studio meters per minute and per day, per model, and publishes no
# endpoint to ask a key's limits. wowlidator paces itself from the documented
# free-tier table (src/providers/rate-pacer.ts), refined by what each 429 body
# states, and waits before crossing 90% of a limit. Your tier, if it differs:
# WOWLIDATOR_GOOGLE_RPM=10
# WOWLIDATOR_GOOGLE_TPM=250000
# WOWLIDATOR_GOOGLE_RPD=250
# Day counts persist in .wowlidator/llm-usage.json (key tail + model, no key).

# Every model request and response is logged to stderr: who asked (role · task),
# model, tokens, pacing state, the first line of the ask, the object returned.
# WOWLIDATOR_LLM_LOG=on        # on (default) | full (untruncated responses) | off
# WOWLIDATOR_LLM_LOG_CHARS=1500

# ---------------------------------------------------------------------------
# Role routing. Any role can point at any provider; these are the defaults.
#
#   healer     repairs a dead selector    small, fast, latency-sensitive
#   generator  writes tests from a page   largest prompt in the system
#   agent      crosses unknown pages      one decision per turn
#   data       regenerates conflicting    small, rare — most data generation
#              form data on a fillRetry   never reaches a model at all
#
# ⚠️ Model ids drift. Run `wowlidator doctor` to confirm each one still resolves.
# ---------------------------------------------------------------------------

# WOWLIDATOR_HEALER_PROVIDER=groq
# WOWLIDATOR_HEALER_MODEL=openai/gpt-oss-120b

# WOWLIDATOR_GENERATOR_PROVIDER=google
# WOWLIDATOR_GENERATOR_MODEL=gemini-3-flash

# WOWLIDATOR_AGENT_PROVIDER=groq
# WOWLIDATOR_AGENT_MODEL=openai/gpt-oss-120b

# WOWLIDATOR_DATA_PROVIDER=groq
# WOWLIDATOR_DATA_MODEL=openai/gpt-oss-120b

# Retries per model call. Free tiers rate-limit hard; the SDK backs off.
# WOWLIDATOR_LLM_MAX_RETRIES=2

# Codex CLI uses the ChatGPT session already signed in on this machine; no API
# key is needed. Any role can select it, for example:
# WOWLIDATOR_GENERATOR_PROVIDER=codex-cli
# WOWLIDATOR_GENERATOR_MODEL=gpt-5.6-terra
# WOWLIDATOR_GENERATOR_EFFORT=medium

# Agy CLI uses the session already signed in on this machine; no API key is
# needed. Any role can select it, for example:
# WOWLIDATOR_GENERATOR_PROVIDER=agy-cli
# WOWLIDATOR_GENERATOR_MODEL=gemini-3.8-flash-medium
# WOWLIDATOR_GENERATOR_EFFORT=medium

# ---------------------------------------------------------------------------
# The claude-* providers (claude-cli, claude-tty, claude-cloud) — the signed-in
# Claude Code session on this machine, needing no key.
#
# claude-cli's command is HARDCODED, by request (2026-08-27): edit the args
# array in src/providers/claude-cli.ts (one-shot `claude -p`) and the launch
# args in src/providers/claude-cli-session.ts (warm session) directly. No env
# var below applies to claude-cli's run script; WOWLIDATOR_CLAUDE_CLI_WARM=0
# keeps only the one-shot vector in play while editing.
#
# How many questions ONE warm process answers before it is retired. The
# default is per role, because the roles want opposite things: a healer or an
# agent is holding a conversation about one page and the earlier turns are the
# context that makes the next answer good (10), while every catalog row is an
# independent question and the rows before it are pure cost — measured
# 2026-08-31, generator asks were reading 126,616 cached tokens each and
# taking 42-57 s for it, so the generator recycles every row (1).
# Raise it only if the ~1.2 s warm restart ever costs more than the context it
# avoids; a value outside 1..40 is ignored.
#
# WOWLIDATOR_SESSION_TURNS=10            # every role
# WOWLIDATOR_GENERATOR_SESSION_TURNS=1   # one role (wins over the line above)
#
# How long ONE claude-cli answer may take, on either vector (warm session and
# cold one-shot share it). Default 15 min. Measured 2026-09-04 on a multirole
# Thai catalog: authoring answers of 17k-24.5k output tokens took 200-265 s
# warm, and one that the old 5 min warm budget abandoned mid-answer was
# re-sent cold and took 595.8 s — paid twice. A timeout never fires on an
# answer that arrives; one shorter than the answer needs is the costliest
# outcome there is. Minimum 60000.
#
# WOWLIDATOR_CLAUDE_CLI_TIMEOUT_MS=900000
#
# The CLI's own output cap (its variable, inherited by every claude-cli
# child): 32,000 by default against a 64,000 model ceiling on opus. A cut at
# the cap is re-asked ONCE at a raised cap toward that ceiling automatically
# and booked in the ledger as finish=length; set this to start there.
#
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000
#
# claude-tty and claude-cloud stay env-adjustable (the panel's Claude session
# card edits these lines):
#
#   the binary: shared, or per provider (per-provider wins)
# WOWLIDATOR_CLAUDE_BIN=claude
# WOWLIDATOR_CLAUDE_TTY_BIN=claude
# WOWLIDATOR_CLAUDE_CLOUD_BIN=claude
#
#   the WHOLE argument line, editable (the panel's args field): {placeholders}
#   expand per call, everything else is literal — delete a flag and it is
#   gone, reorder and it reorders. Unset = the provider's default line.
#   Placeholders: {model-args} {effort-args} {extra-args}, plus for cloud
#   {attach-args} (required). The MODEL is never set here: {model-args} is
#   required (it expands to the role selector's choice) and a literal
#   --model is refused, in these lines and in the extra args alike.
# WOWLIDATOR_CLAUDE_TTY_ARGS={model-args} {effort-args} --strict-mcp-config {extra-args}
# WOWLIDATOR_CLAUDE_CLOUD_ARGS={attach-args} {model-args} {effort-args} --strict-mcp-config {extra-args}
#
#   extra launch arguments: shell-style quoting, landing where {extra-args}
#   sits (last by default, so a flag here overrides the provider's own),
#   never run through a shell. Shared first, then the provider's own.
# WOWLIDATOR_CLAUDE_EXTRA_ARGS=
# WOWLIDATOR_CLAUDE_TTY_EXTRA_ARGS=--permission-mode plan
# WOWLIDATOR_CLAUDE_CLOUD_EXTRA_ARGS=
#
# Every `claude -p` call (the claude-cli provider) is tracked in a JSONL
# ledger — one row per call with model, tokens, cost and wall time, across
# every process run from this directory. Summarised on the panel's Claude
# session card. Off, or a different file:
# WOWLIDATOR_CLAUDE_CLI_USAGE=on           # on (default) | off
# WOWLIDATOR_CLAUDE_CLI_USAGE_PATH=.wowlidator/claude-cli-usage.jsonl
#
# The generator, healer and agent roles on claude-cli may search the run's
# repo context graph + context documents through a loopback BM25 MCP tool
# (src/providers/claude-retrieval.ts). The tool only attaches when a command
# registered something to search; off entirely with:
# WOWLIDATOR_CLAUDE_CLI_RETRIEVAL=on       # on (default) | 0 = off
#
# claude-cloud runs the model in a Claude Code CLOUD session on this account
# (`claude --cloud` behind the same warm terminal claude-tty uses). Attach to
# an existing session by id or claude.ai/code URL; unset, a fresh worker
# session is created per terminal. Point a role at it like any provider:
# WOWLIDATOR_AGENT_PROVIDER=claude-cloud
# WOWLIDATOR_CLAUDE_CLOUD_SESSION=
#
# Live quota (the same numbers Claude Code's /usage shows — session, weekly,
# and the weekly rows scoped to one model type) is read from the signed-in
# session's own credential and shown in the panel and beside each claude call
# in the run log. Off, or a different refresh window:
# WOWLIDATOR_CLAUDE_QUOTA=on               # on (default) | off
# WOWLIDATOR_CLAUDE_QUOTA_TTL_MS=30000
#
# A hard cap on the signed-in session, in PERCENT of any window the account
# reports (session, week, week per model). When one reaches the cap the panel
# stops every running job and holds new ones until reset (Models & keys →
# Claude session → Usage cap), and every process calling claude-cli refuses
# its next call. Off by default; edited from the panel.
# WOWLIDATOR_USAGE_CAP=off                 # on | off (default)
# WOWLIDATOR_USAGE_CAP_PERCENT=90          # 1–100

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# The three "retry" rules, each toggleable here so a terminal run and the
# panel obey the same line (each also has a per-run flag):
#   - in-run step reconstruction (rebuild a failed step and retry, up to 3
#     total tries before it is classified). On by default; --no-reconstruct.
# WOWLIDATOR_RECONSTRUCT=on                 # on (default) | off
#   - the workflow agent's early give-up (concede a leg after 3 look-only /
#     5 no-progress turns). On by default; off raises both to 25 (tries much
#     longer). Flag: --no-agent-early-stop.
# WOWLIDATOR_AGENT_EARLY_STOP=on            # on (default) | off
#   - whole-flow repair (rerun a failed case up to N attempts). Off by
#     default; flag --repair, attempt count via --repair-attempts.
# WOWLIDATOR_REPAIR=off                     # off (default) | on

# WOWLIDATOR_CDP_URL=http://localhost:9222
# WOWLIDATOR_CACHE_PATH=healed-selectors.json
# WOWLIDATOR_PROOF_DIR=.wowlidator/proofs
# WOWLIDATOR_REPORT_DIR=.wowlidator/reports
# WOWLIDATOR_REPORT_PATH=artifacts/{date}/{name}.html   # file, dir, or {placeholder} template
# WOWLIDATOR_DISABLE_REPORT=1              # skip HTML report generation
# Film the run, with a pointer drawn into the page so clicks are visible. A
# still cannot show a click, only the page on either side of one. The recording
# is embedded in the report and every step can be played from.
#
# Recording needs a browser context wowlidator creates, so a filmed run does
# NOT inherit the attached browser's cookies — set this to off for a run that
# depends on a session someone signed into by hand.
# WOWLIDATOR_VIDEO=on                      # on (default) | off
# Perform like a person for the film — pointer travel and hover before a
# press, values typed character by character, a beat after a navigation.
# Unset follows the recording: on while filming, off with video off. Never
# changes what a step resolves or asserts; an unfilmed run pays nothing.
# WOWLIDATOR_HUMANIZE=1                    # 1 | 0 (default: follows WOWLIDATOR_VIDEO)
# Stills. `auto` follows the recording: failures only while filming, since the
# video already carries every other step, and every step when filming is off —
# where the frame before a failure is usually where the wrong thing happened
# and cannot be recovered afterwards. Set a mode explicitly to have both.
# WOWLIDATOR_SCREENSHOTS=auto              # auto (default) | all | on-event | on-failure | off
# Settle before each capture. A navigation waits for domcontentloaded, which
# fires before a client-rendered app has drawn anything — capture on that event
# and the filmstrip is a reel of empty shells for steps that passed. Raise it
# for a slow or heavily animated app; 0 captures as early as the load states
# allow.
# WOWLIDATOR_CAPTURE_DELAY_MS=250           # milliseconds, 0–30000
# WOWLIDATOR_VIEWPORT=1920x1080           # page size for runs and captures; `off` keeps the window's own size
# WOWLIDATOR_DISABLE_HEALING=1             # run execution-plane only
# WOWLIDATOR_DISABLE_AGENT=1               # make `workflow` steps fail instead of navigating
# Let the agent rescue a control the healer cannot find — one that is behind a
# closed menu, below the fold, or on a view still loading. It drives the browser
# until the control is reachable, then YOUR selector is retried against the page
# it opened up; the step still has to resolve on its own terms, and an assertion
# is never offered this. Off by default because it changes the application
# before the step runs.
# WOWLIDATOR_AGENT_ASSIST=1                 # same as --agent-assist
# Keep the browser out of your way. Set this and no window ever appears — a
# browser wowlidator already has open is restarted without one, so it takes
# effect on the second run of the day as well as the first. Screenshots, the
# accessibility tree and the filmstrip are all unaffected. --no-headless on a
# single command overrides it when you want to watch a run.
# WOWLIDATOR_HEADLESS=1
# Chromes for a parallel run: the CDP port plus n-1 ports after it, each on its
# own profile, headless. Same as --browsers <n>. One browser's main thread queues
# every lane, so a run at --concurrency 8 on one Chrome waits on Chrome.
# WOWLIDATOR_BROWSERS=4
# Renderer sandbox off. Containers only — Chrome runs headless perfectly well
# sandboxed on a desktop, and this browser loads the application under test.
# WOWLIDATOR_CHROME_NO_SANDBOX=1

# --- Database verification (docs/db-verification-spec.md) --------------------
# Read-only connection for the DB verification steps (expectDbRow, dbSnapshot,
# expectDbDelta, expectDbUnchanged, expectDbCalled) and for schema
# introspection when `context build` finds no schema file. The driver is a
# lazy optional import — install it where verification is wanted:
#   npm install pg
# WOWLIDATOR_DB_URL=postgres://wowlidator_ro:password@localhost:5432/app
# A DSN resolving to a non-loopback host is refused without this opt-in:
# WOWLIDATOR_DB_REMOTE_OK=1

# --- Database baseline: snapshot → compare → restore (src/db/baseline.ts) -----
# Before a run, the tables the flows are about are detected and snapshotted;
# on every backend step the report shows what the step did to them vs that
# snapshot; after the run the tables can be put back.
#   auto (default): as much as the connections allow — off with no DB URL,
#     snapshot+compare with WOWLIDATOR_DB_URL, restore too with the URL below.
#   snapshot: detect + snapshot + compare, never restore.
#   restore:  also restore. off: none of it. Also: --db-baseline <mode>.
# WOWLIDATOR_DB_BASELINE=auto
# A SEPARATE write credential, used ONLY by the restore (the URL above stays
# read-only). Every restore statement is printed before it runs; only the
# baseline's own tables are touched. Non-loopback still needs DB_REMOTE_OK=1.
# WOWLIDATOR_DB_RESTORE_URL=postgres://wowlidator_rw:password@localhost:5432/app
# Tables to add to the detected set (also --db-baseline-tables a,b):
# WOWLIDATOR_DB_BASELINE_TABLES=
# A table with more rows than this is compared but not snapshotted/restored:
# WOWLIDATOR_DB_BASELINE_MAX_ROWS=50000

# Pre-run dead-end risk (src/generator/dead-end-risk.ts). After a catalog case is
# authored, one small generator-role call judges — from the case, the flow, the
# retrieved documents and the repository — how likely the run is to end as a
# dead-end or error. Above the threshold the case runs ONCE with no healer, no
# reconstruction and no repair loop — the agent stays, once per step; the
# verdict is recorded as usual and nothing is rerun on failure.
# WOWLIDATOR_RISK=off              # skip the assessment; every case gets every retry path
# WOWLIDATOR_RISK_THRESHOLD=50     # percent, 1-99; "fail-fast" above it (default 50)

# Post-run system-error diagnosis (src/generator/error-diagnosis.ts). A run that
# ends as a SYSTEM ERROR (status error — no verdict delivered) gets one
# healer-role call naming which layer broke — test-catalog, generator, agent,
# environment, application — and the fix when one exists. On the bundle
# (`diagnosis`), the notes, the run log and the panel's why-block.
# WOWLIDATOR_DIAGNOSE=off          # skip the diagnosis call

# Section-sharded parallelism (docs/parallel-run-spec.md). Cases carry the data
# SECTIONS they touch (DB tables expanded to their FK join family, route
# families); two writers share the pool only when their sections are disjoint.
# A writer with no evidence of where it writes, or one that deletes, still runs
# alone. Off restores the old rule: any writer runs with nothing else in flight.
# WOWLIDATOR_SECTIONS=off

# The queue governor (src/orchestrator/queue-governor.ts): one agent per suite
# run keeping lanes at maximum while conflicts stay resolved. Event-driven and
# hard-budgeted — cheap even on an expensive model. Its db-write tool (seeding a
# verification fixture) works only with the admin DSN set; DELETE is refused
# outright either way.
# WOWLIDATOR_GOVERNOR=rules          # default: deterministic rules governor ($0). "model" = the LLM governor (can seed fixtures); "off" = none
# WOWLIDATOR_GOVERNOR_TURNS=12       # model turns per suite, 1-100
# WOWLIDATOR_GOVERNOR_PROVIDER=claude-cli   # point it at a preferred model…
# WOWLIDATOR_GOVERNOR_MODEL=opus            # …the turn budget bounds the spend, not the model
# WOWLIDATOR_DB_ADMIN_URL=postgres://writer@localhost:5432/app

# The scenario gate: authoring holds to the scenario the runner is in. Off,
# every row authors as fast as the authoring pool allows — more cases reach
# the parallel lanes sooner. Also editable from the panel's Machinery card,
# alongside WOWLIDATOR_SECTIONS / _GOVERNOR / _RISK / _DIAGNOSE / _AUTO_PROVE.
# WOWLIDATOR_SCENARIO_GATE=off

# Machinery dials (also editable on the panel's Machinery card):
# WOWLIDATOR_AUTHOR_CONCURRENCY=3  # rows authored side by side, 1-12 (an explicit --author-concurrency wins)
# WOWLIDATOR_AUTHOR_ATTEMPTS=3     # authoring asks per row incl. the first, 1-5 (--author-attempts wins)

# --- Authoring-time value resolution (src/generator/value-resolution.ts) -------
# A sheet's placeholder token (<NON_EXISTING_EMPLOYEE_ID>) or described value is
# resolved before the lints: the case's own test data, then the documents and
# repository index (agent role), then the database (read-only, WOWLIDATOR_DB_URL),
# then a GENERATED stand-in the step and every report flag. Off refuses the token.
# WOWLIDATOR_VALUE_RESOLUTION=off

# Authoring re-asks. A refusal re-asks the generator with the refusal as
# feedback; when the first answer held several cases, the re-ask rewrites only
# the refused ones and the harness keeps the rest verbatim. Two dials:
#   the model for attempts after the first (same provider as the generator
#   role; unset = the generator's own model throughout)
# WOWLIDATOR_GENERATOR_RETRY_MODEL=sonnet
#   the repository section is dropped from re-asks to keep them short; `keep`
#   sends it on every attempt as before
# WOWLIDATOR_AUTHOR_RETRY_CONTEXT=keep

# --- Action authority (src/orchestrator/mutation-policy.ts, 2026-09-05) --------
# The host's mutation policy for every `workflow` leg: which categories may
# change the application (submit | delete | approve), and which irreversible
# ones (delete, approve) are pre-approved. Unset = no manifest: capability is
# unrestricted, provenance is still enforced from the observed page, and an
# irreversible action still needs the host's explicit approval hook. A held action is recorded `blocked` — no verdict,
# never a defect — and the case scores blocked, not failed.
# WOWLIDATOR_MUTATION_POLICY={"allow":["submit","delete"],"deny":["approve"],"approved":[{"category":"delete","target":"SIT_DUP_DOC"}]}
